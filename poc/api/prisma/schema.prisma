generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementType {
  INCOME
  EXPENSE
}

model Account {
  id            String     @id @db.VarChar(80)
  name          String     @db.VarChar(80)
  openingCents  BigInt
  requestHash   String     @db.Char(64)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  movements     Movement[]
}

model Movement {
  id           String       @id @db.VarChar(80)
  accountId    String       @db.VarChar(80)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         MovementType
  description  String       @db.VarChar(200)
  amountCents  BigInt
  occurredAt   DateTime     @db.Timestamptz(3)
  requestHash  String       @db.Char(64)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([accountId, occurredAt])
}

enum GroupMode {
  PAREJA
  FAMILIA
}

model Group {
  id          String               @id @db.Uuid
  type        GroupMode
  revision    BigInt               @default(0)
  memberships GroupMembership[]
  operations  GroupModeOperation[]
}

model GroupMembership {
  groupId       String  @db.Uuid
  userId        String  @db.Uuid
  active        Boolean @default(true)
  canChangeMode Boolean @default(false)
  group         Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model GroupModeOperation {
  groupId      String   @db.Uuid
  actorId      String   @db.Uuid
  operationKey String   @db.VarChar(80)
  requestHash  String   @db.Char(64)
  result       Json
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, actorId, operationKey])
}
